int OnInit() {
   if(!MQLInfoInteger(MQL_TESTER)) return INIT_FAILED;
   TwisterRecoveredInputs p; TwisterRecoveredSettings s;
   TwisterRecoveredDefaults(p);
   TwisterRecoverSettings(p,true,s);
   TwisterRecoverPriceDistances(0.001,s);
   Emit("default",s);
   TwisterRecoveredDefaults(p);
   p.EAMode=2;
   TwisterRecoverSettings(p,true,s);
   TwisterRecoverPriceDistances(0.001,s);
   Emit("mode2",s);
   TwisterRecoveredDefaults(p);
