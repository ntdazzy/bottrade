   TwisterRecoverSettings(p,true,s);
   TwisterRecoverPriceDistances(0.001,s);
   Emit("lower",s);
   TwisterRecoveredDefaults(p);
   p.BrokerType=1;
   p.EAMode=2;
   p.FixedLot=1234.0;
   p.RiskPercent=234.0;
   p.MaxConsecLosses=456;
   p.DD_LotMultiplier=3.0;
   p.MaxDailyDD_Pct=123.0;
   p.InpSL_Points=1000001;
   p.InpTP_Points=2147483647;
   p.InpTSL_Start=1000002;
   p.InpTSL_Step=1000003;
   p.InpTSL_Distance=1000004;
   TwisterRecoverSettings(p,true,s);
   TwisterRecoverPriceDistances(0.001,s);
   Emit("upper",s);
   TwisterRecoveredDefaults(p);
   p.InpMagic=-731;
   p.UseFixedLot=true;
   p.UseDD_Protection=true;
   p.FixedLot=0.07;
   p.RiskPercent=1.375;
   p.MaxConsecLosses=7;
   p.DD_LotMultiplier=0.625;
   p.MaxDailyDD_Pct=7.125;
   p.InpSL_Points=1301;
   p.InpTP_Points=2303;
   p.InpTSL_Start=401;
   p.InpTSL_Step=101;
   p.InpTSL_Distance=211;
   TwisterRecoverSettings(p,true,s);
   TwisterRecoverPriceDistances(0.001,s);
   Emit("custom",s);
   TwisterRecoveredDefaults(p);
   p.BrokerType=1;
   p.InpMagic=-731;
   p.InpSL_Points=1301;
   p.InpTP_Points=2303;
   p.InpTSL_Start=401;
   p.InpTSL_Step=101;
   p.InpTSL_Distance=211;
   TwisterRecoverSettings(p,true,s);
   TwisterRecoverPriceDistances(0.001,s);
   Emit("broker1_custom",s);
