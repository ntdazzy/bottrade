#ifndef BOT1_INPUTS_MQH
#define BOT1_INPUTS_MQH
// Input names and defaults copied from the verified MT5 .set snapshot.
input bool ShowInfoPanel=true;
input bool UpdateInfoTesting=false;
input double InfoPanelSizeAdjust=1.0;
input int SetFontSize=0;
input string BacktestSpeed_string="------------------------------ Backtest Speed settings ------------------------------";
input int BacktestSpeed=1;
input string spreadfilter="------------------------------ settings ------------------------------";
input bool AllowBuyTrades=true;
input bool AllowSellTrades=true;
input bool RunStrategyA=true;
input bool RunStrategyB=true;
input bool RunStrategyC=true;
input bool RunStrategyD=true;
input bool RunStrategyE=true;
input bool RunStrategyF=true;
input bool RunStrategyG=true;
input bool RunStrategyH=true;
input double MaxSpread=500.0;
input bool UseVariableValues=true;
input bool UseHL_TrailingSL=true;
input int FridayStopHour=25;
input bool setSL_TP_After_Entry=false;
input bool Virtual_expiration=true;
input double Randomization=0.0;
input int FakeOutFilter=1;
input bool EnableVirtualSLTP=false;
input int SetVSL_to_hardSL_sec_delay=99;
input int ST1_MagicNumber=9000;
input string ST1_Comment="Gold Trade Pro";
input bool RemoveCommentSuffix=false;
input string NFP_FILTER="----------------------- NFP Filter -----------------------";
input bool EnableNFP_Filter=true;
input bool UseMQL5Calendar=true;
input bool AutoGMT=true;
input int Broker_GMT_OFFSET_Winter=2;
input int Broker_GMT_OFFSET_Summer=3;
input bool NFP_CloseOpenTrades=true;
input bool NFP_ClosePendingOrders=true;
input int NFP_MinutesBefore=10;
input int NFP_MinutesAfter=240;
input string IR_FILTER="----------------------- Interest Rate Filter -----------------------";
input bool EnableIR_Filter=false;
input bool IR_CloseOpenTrades=true;
input bool IR_ClosePendingOrders=true;
input int IR_MinutesBefore=100;
input int IR_MinutesAfter=60;
input string CPI_FILTER="----------------------- CPI Filter -----------------------";
input bool EnableCPI_Filter=false;
input bool CPI_CloseOpenTrades=true;
input bool CPI_ClosePendingOrders=true;
input int CPI_MinutesBefore=100;
input int CPI_MinutesAfter=60;
input string propfirmsettings="----------------------- Propfirm unique trades settings -----------------------";
input double AdjustEntry=0.0;
input double AdjustSL=0.0;
input double AdjustTP=0.0;
input double AdjustTrailSL=0.0;
input string LotSizeSettings="----------------------- LotSize Settings -----------------------";
input double ManualBalance=0.0;
input double StartLots=0.01;
input int Risk=0;
input double Manual_RiskPerTrade=1.2;
input double MaxRiskPerStrategy=3.0;
input double PropFirmMaxDailyDD=0.0;
input int LotPerBalance_step=600;
input bool OnlyUp=true;
input bool ResetHighestBalance=false;
input bool ResetHighestBalanceOnWithdrawal=true;
input bool CheckMargin=true;
input bool UseEquity=false;
input bool AdjustLotsizeToVariableValues=true;
#endif
