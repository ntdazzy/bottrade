#property strict
input string CheckRun="";
#include "../../Include/bot-cua-toi-1/Bot1Inputs.mqh"

int WriteText(const int handle,const string value)
{
   if(value==NULL) { FileWriteInteger(handle,-1); return 0; }
   int length=StringLen(value); FileWriteInteger(handle,length);
   if(length>0) FileWriteString(handle,value,length);
   return length;
}

bool ValidRun(const string value)
{
   int length=StringLen(value);
   if(length<1 || length>48) return false;
   for(int i=0;i<length;i++)
   {
      ushort c=StringGetCharacter(value,i);
      if(!((c>='a' && c<='z') || (c>='0' && c<='9') || c=='-')) return false;
   }
   return true;
}

int OnStart()
{
   if(!ValidRun(CheckRun)) { Print("INVALID_CHECK_RUN:",CheckRun,":",StringLen(CheckRun));return 1; }
