#property strict
input string CheckRun="";
#include "../../Include/bot-cua-toi-1/Bot1StartupInputs.mqh"
union Number{double value;ulong word;};
ulong Bits(const double value){Number n;n.value=value;return n.word;}
double Value(const ulong word){Number n;n.word=word;return n.value;}
void Text(const int output,const string value){int n=value==NULL ? -1 : StringLen(value);FileWriteInteger(output,n);if(n>0)FileWriteString(output,value,n);}
int OnStart()
{
   if(CheckRun=="")return 1;string folder="bot1-startup-inputs\\"+CheckRun+"\\";
   int file=FileOpen(folder+"cases.bin",FILE_READ|FILE_BIN);if(file==INVALID_HANDLE)return 2;
   int magic=FileReadInteger(file),version=FileReadInteger(file),count=FileReadInteger(file);if(magic!=0x44493131 || version!=1 || count!=4)return 3;
   int output=FileOpen(folder+"mql5-results.bin",FILE_WRITE|FILE_BIN);if(output==INVALID_HANDLE)return 4;
   FileWriteInteger(output,magic);FileWriteInteger(output,version);FileWriteInteger(output,count);
   for(int k=0;k<count;k++)
   {
      int id=FileReadInteger(file);Bot1PreparationInputs Inputs;
      Inputs.indicator_period=(int)FileReadLong(file);
      Inputs.indicator_day=(uchar)FileReadLong(file);
      Inputs.reference=Value((ulong)FileReadLong(file));
      Inputs.variable_distances=(uchar)FileReadLong(file);
      Inputs.adjust_lots=(uchar)FileReadLong(file);
      Inputs.max_spread=Value((ulong)FileReadLong(file));
      Inputs.feature_flag=(uchar)FileReadLong(file);
      Inputs.freeze_buffer_flag=(uchar)FileReadLong(file);
      Inputs.entry.confirmation_frame=(int)FileReadLong(file);
      Inputs.entry.hour1_flag=(uchar)FileReadLong(file);
      Inputs.entry.older_width=(int)FileReadLong(file);
      Inputs.entry.recent_width=(int)FileReadLong(file);
      Inputs.entry.last_shift=(int)FileReadLong(file);
      Inputs.entry.gap_points=Value((ulong)FileReadLong(file));
      Inputs.buy_offset=Value((ulong)FileReadLong(file));
      Inputs.sell_offset=Value((ulong)FileReadLong(file));
      Inputs.nearby_radius=Value((ulong)FileReadLong(file));
      Inputs.expiration_hours=(int)FileReadLong(file);
      Inputs.virtual_expiration=(uchar)FileReadLong(file);
      Inputs.stop_distance=Value((ulong)FileReadLong(file));
      Inputs.target_distance=Value((ulong)FileReadLong(file));
      Inputs.trail_distance=Value((ulong)FileReadLong(file));
      Inputs.trail_start=Value((ulong)FileReadLong(file));
      Inputs.trail_limit=Value((ulong)FileReadLong(file));
      Inputs.trail_step=Value((ulong)FileReadLong(file));
      Inputs.aux_hour1=(uchar)FileReadLong(file);
      Inputs.aux_scan50=(uchar)FileReadLong(file);
      Inputs.aux_older=(int)FileReadLong(file);
      Inputs.aux_recent=(int)FileReadLong(file);
      Inputs.aux_offset=Value((ulong)FileReadLong(file));
      Inputs.min_change=Value((ulong)FileReadLong(file));
      Inputs.native_62218=Value((ulong)FileReadLong(file));
      Inputs.native_62220=(uchar)FileReadLong(file);
      Inputs.native_62228=Value((ulong)FileReadLong(file));
      Inputs.native_62230=Value((ulong)FileReadLong(file));
      Inputs.native_62238=Value((ulong)FileReadLong(file));
      Inputs.native_62240=(uchar)FileReadLong(file);
      Inputs.native_6a5d8=(int)FileReadLong(file);
      Inputs.omit_real_sl_tp=(uchar)FileReadLong(file);
      Inputs.virtual_stops=(uchar)FileReadLong(file);
      Inputs.native_6a608=(int)FileReadLong(file);
      Inputs.check_free_margin=(uchar)FileReadLong(file);
      Inputs.native_62268=(uchar)FileReadLong(file);
      Inputs.native_622a8=(uchar)FileReadLong(file);
      Inputs.native_622ec=(int)FileReadLong(file);
      Inputs.native_622f0=(uchar)FileReadLong(file);
      Inputs.native_62390=Value((ulong)FileReadLong(file));
      Inputs.native_62398=(uchar)FileReadLong(file);
      Inputs.native_623a8=Value((ulong)FileReadLong(file));
      Inputs.native_6a740=Value((ulong)FileReadLong(file));
      Inputs.native_623b0=Value((ulong)FileReadLong(file));
      Inputs.native_6a748=(int)FileReadLong(file);
      Inputs.native_6a750=Value((ulong)FileReadLong(file));
      Inputs.native_6a768=(int)FileReadLong(file);
      Inputs.symbol="XAUUSD.test";Inputs.comment="must change";
      Bot1InitializeStartupInputs(Inputs);
      FileWriteInteger(output,id);
      FileWriteLong(output,(long)Inputs.indicator_period);
      FileWriteLong(output,(long)Inputs.indicator_day);
      FileWriteLong(output,(long)Bits(Inputs.reference));
      FileWriteLong(output,(long)Inputs.variable_distances);
      FileWriteLong(output,(long)Inputs.adjust_lots);
      FileWriteLong(output,(long)Bits(Inputs.max_spread));
      FileWriteLong(output,(long)Inputs.feature_flag);
      FileWriteLong(output,(long)Inputs.freeze_buffer_flag);
      FileWriteLong(output,(long)Inputs.entry.confirmation_frame);
      FileWriteLong(output,(long)Inputs.entry.hour1_flag);
      FileWriteLong(output,(long)Inputs.entry.older_width);
      FileWriteLong(output,(long)Inputs.entry.recent_width);
      FileWriteLong(output,(long)Inputs.entry.last_shift);
      FileWriteLong(output,(long)Bits(Inputs.entry.gap_points));
      FileWriteLong(output,(long)Bits(Inputs.buy_offset));
      FileWriteLong(output,(long)Bits(Inputs.sell_offset));
      FileWriteLong(output,(long)Bits(Inputs.nearby_radius));
      FileWriteLong(output,(long)Inputs.expiration_hours);
      FileWriteLong(output,(long)Inputs.virtual_expiration);
      FileWriteLong(output,(long)Bits(Inputs.stop_distance));
      FileWriteLong(output,(long)Bits(Inputs.target_distance));
      FileWriteLong(output,(long)Bits(Inputs.trail_distance));
      FileWriteLong(output,(long)Bits(Inputs.trail_start));
      FileWriteLong(output,(long)Bits(Inputs.trail_limit));
      FileWriteLong(output,(long)Bits(Inputs.trail_step));
      FileWriteLong(output,(long)Inputs.aux_hour1);
      FileWriteLong(output,(long)Inputs.aux_scan50);
      FileWriteLong(output,(long)Inputs.aux_older);
      FileWriteLong(output,(long)Inputs.aux_recent);
      FileWriteLong(output,(long)Bits(Inputs.aux_offset));
      FileWriteLong(output,(long)Bits(Inputs.min_change));
      FileWriteLong(output,(long)Bits(Inputs.native_62218));
      FileWriteLong(output,(long)Inputs.native_62220);
      FileWriteLong(output,(long)Bits(Inputs.native_62228));
      FileWriteLong(output,(long)Bits(Inputs.native_62230));
      FileWriteLong(output,(long)Bits(Inputs.native_62238));
      FileWriteLong(output,(long)Inputs.native_62240);
      FileWriteLong(output,(long)Inputs.native_6a5d8);
      FileWriteLong(output,(long)Inputs.omit_real_sl_tp);
      FileWriteLong(output,(long)Inputs.virtual_stops);
      FileWriteLong(output,(long)Inputs.native_6a608);
      FileWriteLong(output,(long)Inputs.check_free_margin);
      FileWriteLong(output,(long)Inputs.native_62268);
      FileWriteLong(output,(long)Inputs.native_622a8);
      FileWriteLong(output,(long)Inputs.native_622ec);
      FileWriteLong(output,(long)Inputs.native_622f0);
      FileWriteLong(output,(long)Bits(Inputs.native_62390));
      FileWriteLong(output,(long)Inputs.native_62398);
      FileWriteLong(output,(long)Bits(Inputs.native_623a8));
      FileWriteLong(output,(long)Bits(Inputs.native_6a740));
      FileWriteLong(output,(long)Bits(Inputs.native_623b0));
      FileWriteLong(output,(long)Inputs.native_6a748);
      FileWriteLong(output,(long)Bits(Inputs.native_6a750));
      FileWriteLong(output,(long)Inputs.native_6a768);
      Text(output,Inputs.symbol);Text(output,Inputs.comment);
   }
   if(FileTell(file)!=FileSize(file))return 5;FileClose(file);FileClose(output);int status=FileOpen(folder+"script-status.bin",FILE_WRITE|FILE_BIN);if(status==INVALID_HANDLE)return 6;
   FileWriteInteger(status,0);FileWriteInteger(status,count);FileClose(status);return 0;
}
