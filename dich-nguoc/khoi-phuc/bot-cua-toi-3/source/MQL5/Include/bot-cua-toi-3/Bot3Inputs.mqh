input double MaxAllowedDD=30.0;
input bool UseWeightedLots=true;
input double MaxRiskPerStrategy_=1.0;
input double PropFirmMaxDailyDD=0.0;
input bool OnlyUp=true;
input bool ResetHighestBalance=false;
input bool ResetHighestBalanceOnWithdrawal=true;
input bool CheckMargin=true;
input bool UseEquity=false;
input string ManualStratSelect="------------------------- Manual Strategy Selection -------------------------";
input string ManStratWarn="!! DO NOT RUN MANUAL STRATEGIES WHILE USING 'MAX ALLOWED TOTAL DD' OPTION !! ";
input bool RunStrat1=true;
input bool RunStrat2=true;
input bool RunStrat3=true;
input bool RunStrat4=true;
input bool RunStrat5=true;
input bool RunStrat6=true;
input bool RunStrat7=true;
input bool RunStrat8=true;
input bool RunStrat9=true;
