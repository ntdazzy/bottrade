input int BacktestSpeed=1;
input string spreadfilter="------------------------------ settings ------------------------------";
input bool AllowBuyTrades=true;
input bool AllowSellTrades=true;
input int TradeFrequency=5;
input double MaxSpread=500.0;
input bool UseHL_TrailingSL=true;
input int FridayStopHour=25;
input bool FridayClosePending=true;
input bool FridayCloseOpen=true;
input bool setSL_TP_After_Entry=false;
input bool Virtual_expiration=true;
input double Randomization=0.0;
input int FakeOutFilter=2;
input bool EnableVirtualSLTP=false;
input int SetVSL_to_hardSL_sec_delay=99;
input int ST1_MagicNumber=8000;
input string ST1_Comment="The Gold Reaper";
input bool RemoveCommentSuffix=false;
input string NFP_FILTER="----------------------- NFP Filter -----------------------";
input bool EnableNFP_Filter=true;
input bool UseMQL5Calendar=true;
input bool AutoGMT=true;
